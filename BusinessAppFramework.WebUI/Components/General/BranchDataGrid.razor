@using BusinessAppFramework.Application.Search
@using BusinessAppFramework.Application.Trees
@using BusinessAppFramework.WebUI.Components.Editor
@using BusinessAppFramework.WebUI.Interfaces
@using Contracts
@using Domain.DomainObjects
@using MudBlazor
@using MudBlazor.Utilities
@using Microsoft.JSInterop

@typeparam TDomainObject where TDomainObject : DomainObject, new()
@typeparam TSearchResult where TSearchResult : DomainObjectSearchResult, new()

@inherits DomainObjectBranchEditor<TDomainObject, TSearchResult>
@implements IAsyncDisposable

@inject IIconFactory IconFactory
@inject IJSRuntime JSRuntime

<MudStack Spacing="2">

    @if (DisplayHeader)
    {
        <MudStack AlignItems="AlignItems.Center" Row="true" Spacing="2">

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@IconFactory.CreateIcon(DomainObjectAggregateKeys<TDomainObject>.Type)" Size="Size.Small" />
                <MudText Typo="Typo.h6">@LocalizedStringService.Get(DomainObjectAggregateKeys<TDomainObject>.Type)</MudText>
            </MudStack>

            <MudStack Row="true" Justify="Justify.FlexStart" Spacing="0">

                <MudIconButton Icon="@Icons.Material.Filled.Add"
                               OnClick="CreateItemAsync"
                               Color="@Color.Primary"
                               Size="Size.Small"
                               Variant="Variant.Text"
                               Style="font-weight: normal;">
                </MudIconButton>

                @ToolBarActions

            </MudStack>

        </MudStack>
    }

    <CascadingValue Value="(Func<Task>)NotifyItemChanged">

        <div class="osc-reorder-container" @ref="_reorderContainer">

        @if (RowDetailContent != null)
        {
            <MudDataGrid T="Node"
                         EditMode="DataGridEditMode.Cell"
                         EditTrigger="DataGridEditTrigger.OnRowClick"
                         Items="@VisibleNodes"
                         SortMode="@SortMode.None"
                         ReadOnly="false"
                         Bordered="true"
                         Dense="true"
                         ColumnResizeMode="ResizeMode.Column"
                         Elevation="0"
                         Class="osc-datagrid"
                         Virtualize="false"
                         CommittedItemChanges="OnCommitedItemChanged">
                <Columns>
                    @if (CanReorder)
                    {
                        <TemplateColumn T="Node" HeaderClass="@DataGridColumnClasses.Compact">
                            <EditTemplate>
                                <span class="osc-row-grip" draggable="true" data-node-id="@context.Item.Id">
                                    <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" />
                                </span>
                            </EditTemplate>
                        </TemplateColumn>
                    }
                    <HierarchyColumn T="Node" EnableHeaderToggle="true" />
                    @ColumnsContent
                    <TemplateColumn T="Node" Title="@LocalizedStringService.Get(StringKeys.ActionsKey)" HeaderClass="@DataGridColumnClasses.Compact">
                        <EditTemplate>
                            <MudStack Row="true" Spacing="0">
                                @ItemActions?.Invoke(context.Item)
                                <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="async () => await DeleteItemAsync(context.Item.Id)" />
                            </MudStack>
                        </EditTemplate>
                    </TemplateColumn>
                </Columns>

                <ChildRowContent Context="rowContext">
                    @RowDetailContent?.Invoke(rowContext.Item)
                </ChildRowContent>

            </MudDataGrid>
        }
        else
        {
            <MudDataGrid T="Node"
                         EditMode="DataGridEditMode.Cell"
                         EditTrigger="DataGridEditTrigger.OnRowClick"
                         Items="@VisibleNodes"
                         SortMode="@SortMode.None"
                         ReadOnly="false"
                         Bordered="true"
                         Dense="true"
                         ColumnResizeMode="ResizeMode.Column"
                         Elevation="0"
                         Class="osc-datagrid"
                         Virtualize="false"
                         CommittedItemChanges="OnCommitedItemChanged">
                <Columns>
                    @if (CanReorder)
                    {
                        <TemplateColumn T="Node" HeaderClass="@DataGridColumnClasses.Compact">
                            <EditTemplate>
                                <span class="osc-row-grip" draggable="true" data-node-id="@context.Item.Id">
                                    <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" />
                                </span>
                            </EditTemplate>
                        </TemplateColumn>
                    }
                    @ColumnsContent
                    <TemplateColumn T="Node" Title="@LocalizedStringService.Get(StringKeys.ActionsKey)" HeaderClass="@DataGridColumnClasses.Compact">
                        <EditTemplate>
                            <MudStack Row="true" Spacing="0">
                                @ItemActions?.Invoke(context.Item)
                                <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="async () => await DeleteItemAsync(context.Item.Id)" />
                            </MudStack>
                        </EditTemplate>
                    </TemplateColumn>
                </Columns>

            </MudDataGrid>
        }

        </div>

    </CascadingValue>

</MudStack>

@code {
    [Parameter] public RenderFragment? ToolBarActions { get; set; }
    [Parameter] public RenderFragment? ColumnsContent { get; set; }
    [Parameter] public RenderFragment<Node>? RowDetailContent { get; set; }
    [Parameter] public RenderFragment<Node>? ItemActions { get; set; }
    [Parameter] public bool DisplayHeader { get; set; } = true;

    private const string ReorderModulePath = "./_content/BusinessAppFramework.WebUI/Components/General/BranchDataGrid.razor.js";

    private ElementReference _reorderContainer;
    private IJSObjectReference? _reorderModule;
    private DotNetObjectReference<BranchDataGrid<TDomainObject, TSearchResult>>? _dotNetReference;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender && CanReorder)
        {
            _dotNetReference = DotNetObjectReference.Create(this);
            _reorderModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", ReorderModulePath);
            await _reorderModule.InvokeVoidAsync("initialize", _reorderContainer, _dotNetReference);
        }
    }

    [JSInvokable]
    public async Task OnRowMovedAsync(int movedNodeId, int targetNodeId, bool insertAfter)
    {
        await MoveNodeAsync(movedNodeId, targetNodeId, insertAfter);
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_reorderModule != null)
            {
                await _reorderModule.InvokeVoidAsync("dispose", _reorderContainer);
                await _reorderModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone, there is nothing left to clean up in the browser.
        }

        _dotNetReference?.Dispose();
    }
}