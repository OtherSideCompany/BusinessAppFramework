@using BusinessAppFramework.Application.Interfaces
@using Domain
@using Microsoft.AspNetCore.Components.Routing
@using MudBlazor
@using WebUI.Interfaces

@inject ILocalizedStringService LocalizedStringService
@inject IWorkspaceNavigationService WorkspaceNavigationService
@inject IIconFactory IconFactory
@inject NavigationManager NavigationManager

@implements IDisposable

<style>
    .nav-menu-icon {
        width: 16px;
        height: 16px;
    }

    .module-text {
        color: #6B7280;
    }

    .nav-item {
        cursor: pointer;
        border-radius: 4px;
        transition: background 0.15s ease;
        color: #6B7280;
    }

        .nav-item:hover {
            color: var(--mud-palette-primary);
        }

            .nav-item:hover .mud-icon-root,
            .nav-item:hover .mud-button-label {
                color: var(--mud-palette-primary);
            }

        .nav-item .mud-button-root:hover {
            background-color: transparent;
        }

    .module-header {
        border-radius: 4px;
        transition: background 0.15s ease;
    }

        .module-header:hover {
            background: rgba(139, 128, 255, 0.08);
        }

    .nav-skeleton {
        background-color: rgba(139, 128, 255, 0.08) !important;
    }
</style>

<MudNavMenu>

    @if (_isLoading)
    {
        <MudStack Spacing="0">
            @for (int i = 0; i < 8; i++)
            {
                <MudSkeleton Height="40px" Class="nav-skeleton mx-2" />
            }
        </MudStack>
    }
    else
    {
        @foreach (var moduleKey in _moduleKeys)
        {
            <div class="module-header" style="display: flex; align-items: center; padding-right: 8px; cursor: pointer; height:40px;" @onclick="() => ToggleModule(moduleKey)">
                <MudIcon Icon="@(IsExpanded(moduleKey) ? Icons.Material.Filled.ArrowDropDown : Icons.Material.Filled.ArrowRight)"
                         Style="color: #4A4D5E; margin-left:12px" />
                <MudText Class="module-text" Typo="Typo.body1">@LocalizedStringService.Get(moduleKey)</MudText>
            </div>

            @if (IsExpanded(moduleKey))
            {
                @foreach (var workspaceKey in _workspaceKeys[moduleKey])
                {
                    var href = GetWorkspaceLink(workspaceKey);
                    var isActive = NavigationManager.Uri.Contains(href);

                    <MudStack Row="true" Spacing="0" AlignItems="AlignItems.Center" Style="padding-left:36px;" Class="nav-item">
                        <MudIcon Icon="@IconFactory.CreateIcon(workspaceKey)"
                                 Class="nav-menu-icon"
                                 Color="@(isActive ? Color.Primary : Color.Inherit)" />
                        <MudButton Href="@href"
                                   FullWidth="true"
                                   Ripple="false"
                                   Style="text-transform: none; justify-content: flex-start;"
                                   Color="Color.Transparent">
                            <MudText Typo="Typo.body2"
                                     Style="@(isActive ? "font-weight:600;" : "")"
                                     Color="@(isActive ? Color.Primary : Color.Inherit)">
                                @LocalizedStringService.Get(workspaceKey)
                            </MudText>
                        </MudButton>
                    </MudStack>
                }
            }
        }
    }


</MudNavMenu>

@code {
    private List<string> _moduleKeys { get; set; } = new()!;
    private Dictionary<string, List<string>> _workspaceKeys { get; set; } = new()!;
    private Dictionary<string, bool> _expandedModules = new();

    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        _moduleKeys = await WorkspaceNavigationService.GetModuleKeysAsync();
        NavigationManager.LocationChanged += OnLocationChanged;

        foreach (var moduleKey in _moduleKeys)
        {
            _workspaceKeys[moduleKey] = await WorkspaceNavigationService.GetWorkspaceKeysAsync(moduleKey);
        }

        _isLoading = false;
    }

    private string GetWorkspaceLink(string workspaceKey) => "/workspace/" + workspaceKey;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    private bool IsExpanded(string moduleKey)
        => _expandedModules.GetValueOrDefault(moduleKey, false);

    private void ToggleModule(string moduleKey)
        => _expandedModules[moduleKey] = !IsExpanded(moduleKey);

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
