@using MudBlazor

<style>
    .stat-nav-link,
    .stat-nav-link * {
        cursor: pointer;
    }
</style>

<MudStack Spacing="1" Row="true" AlignItems="AlignItems.Center">

    <MudIcon Icon="@Icon" Size="Size.Small" Style="width:16px; height:16px;" />

    <MudText Typo="Typo.body1">@Label</MudText>

    @if (!string.IsNullOrEmpty(NavigationRoute))
    {
        <MudLink Href="@NavigationRoute"
                 @onclick:stopPropagation="true"
                 Class="stat-nav-link"
                 Style="color: var(--mud-palette-primary-darken) !important; font-weight:700;"
                 Typo="Typo.h5">
            @_displayValue
        </MudLink>
    }
    else
    {
        <MudText Typo="Typo.h5" Style="font-weight:700;">@_displayValue</MudText>
    }

</MudStack>


@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public object? Value { get; set; } = string.Empty;
    [Parameter] public string? Unit { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = string.Empty;
    [Parameter] public string? NavigationRoute { get; set; }

    private string _displayValue => string.IsNullOrEmpty(Unit) ? $"{Value}" :
                                                                 $"{Value} {Unit}";
}