@using MudBlazor

<style>
    .stat-nav-link,
    .stat-nav-link * {
        cursor: pointer;
    }
</style>

<MudStack Spacing="1" Row="true">

    <MudIcon Icon="@Icon" Size="Size.Small" Style="color:var(--mud-palette-text-secondary);" />

    <MudText Typo="Typo.body1" Style="color:var(--mud-palette-text-secondary);">@Label</MudText>

    <div class="ml-1">
        @if (!string.IsNullOrEmpty(NavigationRoute))
        {
            <MudLink Href="@NavigationRoute"
                     @onclick:stopPropagation="true"
                     Class="stat-nav-link"
                     Style="color: var(--mud-palette-primary-darken) !important; font-weight:500;"
                     Typo="Typo.h5">
                @_displayValue
            </MudLink>
        }
        else
        {
            <MudText Typo="Typo.body1" Style="font-weight:500;">@_displayValue</MudText>
        }
    </div>

</MudStack>


@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public object? Value { get; set; } = string.Empty;
    [Parameter] public string? Unit { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = string.Empty;
    [Parameter] public string? NavigationRoute { get; set; }

    private string _displayValue => string.IsNullOrEmpty(Unit) ? $"{Value}" :
                                                                 $"{Value} {Unit}";
}