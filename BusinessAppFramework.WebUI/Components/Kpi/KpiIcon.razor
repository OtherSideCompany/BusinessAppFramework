@using MudBlazor

<span style="flex:0 0 auto; display:flex; align-items:center; justify-content:center; width:32px; height:32px; border-radius:8px; color:var(--mud-palette-primary); background:rgba(var(--mud-palette-primary-rgb), .1);">
    <MudIcon Icon="@Icon" Size="Size.Small" />
</span>

@code {
    [Parameter, EditorRequired] public string Icon { get; set; } = string.Empty;
}
