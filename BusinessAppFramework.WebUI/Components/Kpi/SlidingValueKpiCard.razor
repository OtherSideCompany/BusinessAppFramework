@using BusinessAppFramework.Application.Interfaces
@using BusinessAppFramework.Contracts
@using BusinessAppFramework.WebUI.Helpers
@using MudBlazor

@inject ILocalizedStringService LocalizedStringService

<style>
    .kpi-card-clickable,
    .kpi-card-clickable * {
        cursor: pointer;
    }

    .kpi-card-clickable {
        margin: -16px;
        padding: 15px;
        border: 1px solid transparent;
        border-radius: 8px;
        transition: box-shadow .15s ease, background-color .15s ease, transform .1s ease;
    }

    .kpi-card-clickable:hover {
        box-shadow: var(--mud-elevation-4);
        border-color: var(--mud-palette-primary);
    }

    .kpi-card-clickable:active {
        transform: scale(0.98);
        box-shadow: var(--mud-elevation-2);
    }

    .kpi-period {
        font-size: .75rem;
        margin-left: 4px;
        opacity: .7;
    }
</style>

<MudStack Spacing="2"
          Class="@(_isClickable ? "kpi-card-clickable" : null)"
          @onclick="OnClickAsync">

    <MudText Style="color:var(--mud-palette-text-secondary);">
        @Label
        @if (Value.TimeframeDays > 0)
        {
            <span class="kpi-period">@Value.TimeframeDays@LocalizedStringService.Get(StringKeys.DayShortKey)</span>
        }
    </MudText>

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
        
        <MudText Typo="Typo.h2" Color="Color.Primary">@DisplayValue(Value.CurrentValue)</MudText>           

        @if (Value.ValueDelta(0) != 0)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                <MudIcon Icon="@_deltaIcon" Size="Size.Small" Color="@_deltaColor" />
                <MudText Typo="Typo.caption" Color="@_deltaColor">@DisplayValue(Value.ValueDelta(0))</MudText>               
            </MudStack>               
        }

    </MudStack>

</MudStack>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public BusinessAppFramework.Application.Kpis.SlidingValueKpi Value { get; set; } = new();
    [Parameter] public bool DisplayFriendlyValue { get; set; }
    [Parameter] public string Units { get; set; } = String.Empty;
    [Parameter] public EventCallback OnClick { get; set; }

    private bool _isClickable => OnClick.HasDelegate;

    private async Task OnClickAsync()
    {
        if (_isClickable)
        {
            await OnClick.InvokeAsync();
        }
    }

    private string _deltaIcon => Value.ValueDelta(0) > 0 ? Icons.Material.Filled.ArrowDropUp : Icons.Material.Filled.ArrowDropDown;
    private Color _deltaColor => Value.ValueDelta(0) > 0 ? Color.Success : Color.Error;

    private string DisplayValue(decimal value)
    {
        var stringValue = "";

        if (DisplayFriendlyValue)
        {
            stringValue = StringHelper.AmountToFriendlyDisplay(value);
        }
        else
        {
            stringValue = value.ToString();
        }

        if (!String.IsNullOrEmpty(Units))
        {
            stringValue = $"{stringValue} {Units}";
        }

        return stringValue;
    }
}
