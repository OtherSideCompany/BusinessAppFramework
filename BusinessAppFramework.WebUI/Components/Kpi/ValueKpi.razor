@using MudBlazor

<style>
    .kpi-card-clickable,
    .kpi-card-clickable * {
        cursor: pointer;
    }

    .kpi-card-clickable {
        margin: -16px;
        padding: 15px;
        border: 1px solid transparent;
        border-radius: 8px;
        transition: box-shadow .15s ease, background-color .15s ease, transform .1s ease;
    }

    .kpi-card-clickable:hover {
        box-shadow: var(--mud-elevation-4);
        border-color: var(--mud-palette-primary);
    }

    .kpi-card-clickable:active {
        transform: scale(0.98);
        box-shadow: var(--mud-elevation-2);
    }
</style>

<MudStack Spacing="2"
          Class="@(_isClickable ? "kpi-card-clickable" : null)"
          @onclick="OnClickAsync">

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        @if (IndicatorColor != null)
        {
            <span style="@($"display:inline-block; width:8px; height:8px; border-radius:50%; background:{IndicatorCssColor};")"></span>
        }
        @if (!string.IsNullOrEmpty(Icon))
        {
            <KpiIcon Icon="@Icon" />
        }
        <MudText Typo="Typo.body2" Style="font-weight:500;">@Label</MudText>
    </MudStack>

    <MudStack Spacing="0">
        <MudText Typo="Typo.h2" Color="Color.Primary">@Value</MudText>

        @if (!string.IsNullOrEmpty(Caption))
        {
            <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary); font-variant-numeric: tabular-nums;">@Caption</MudText>
        }
    </MudStack>

</MudStack>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public string? Caption { get; set; }
    [Parameter] public Color? IndicatorColor { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private bool _isClickable => OnClick.HasDelegate;

    private async Task OnClickAsync()
    {
        if (_isClickable)
        {
            await OnClick.InvokeAsync();
        }
    }

    private string IndicatorCssColor => IndicatorColor switch
    {
        Color.Primary => "var(--mud-palette-primary)",
        Color.Secondary => "var(--mud-palette-secondary)",
        Color.Success => "var(--mud-palette-success)",
        Color.Error => "var(--mud-palette-error)",
        Color.Warning => "var(--mud-palette-warning)",
        Color.Info => "var(--mud-palette-info)",
        _ => "var(--mud-palette-text-disabled)"
    };
}
