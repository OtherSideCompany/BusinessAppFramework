@page "/document-generator/{DocumentKey}/{Id:int}"

@using BusinessAppFramework.Application.Interfaces
@using BusinessAppFramework.Contracts
@using BusinessAppFramework.Contracts.ApiRoutes
@using BusinessAppFramework.WebUI.Documents
@using BusinessAppFramework.WebUI.Interfaces
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@using MudBlazor

@attribute [Authorize]
@implements IAsyncDisposable

@inject IDocumentGeneratorGateway DocumentGeneratorGateway
@inject ILocalizedStringService LocalizedStringService
@inject IUserDialogService UserDialogService
@inject IJSRuntime JS

<div class="osc-document-viewer-surface">

    <div class="osc-document-viewer">

        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Spacing="0">
            <MudIconButton Icon="@Icons.Material.Outlined.Download"
                           Disabled="@(_pdfResult is null)"
                           OnClick="DownloadPdfDocument" />
            <MudIconButton Icon="@Icons.Material.Outlined.Print"
                           Disabled="@(_pdfResult is null)"
                           OnClick="PrintPdfDocument" />
        </MudStack>

        @if (_isLoading)
        {
            <div style="display:flex; justify-content:center; align-items:center; flex:1 1 auto; min-height:0;">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            </div>
        }
        else if (_pdfObjectUrl is not null)
        {
            <div class="osc-document-viewer-frame">
                <iframe id="@_pdfFrameId"
                        src="@($"{_pdfObjectUrl}#toolbar=0")"
                        title="@_pdfResult?.FileName"></iframe>
            </div>
        }

    </div>

</div>

@code {
    [Parameter] public string DocumentKey { get; set; } = "";
    [Parameter] public int Id { get; set; }

    private const string _pdfFrameId = "document-generator-pdf-frame";

    private bool _isLoading = true;
    private DocumentDownloadResult? _pdfResult;
    private string? _pdfObjectUrl;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;

        await ReleaseObjectUrlAsync();
        _pdfResult = null;

        _pdfResult = await DocumentGeneratorGateway.DownloadPdfAsync(DocumentKey, Id);

        if (_pdfResult is null)
        {
            UserDialogService.SnackError(LocalizedStringService.Get(MessageKeys.FileNoteFoundMessage) ?? "file_not_found_msg");
        }
        else
        {
            var base64 = Convert.ToBase64String(_pdfResult.Content);
            _pdfObjectUrl = await JS.InvokeAsync<string>("oscCreateBlobUrl", _pdfResult.ContentType, base64);
        }

        _isLoading = false;
    }

    private async Task DownloadPdfDocument()
    {
        if (_pdfResult is null)
            return;

        var base64 = Convert.ToBase64String(_pdfResult.Content);
        await JS.InvokeVoidAsync("oscDownload", _pdfResult.FileName, _pdfResult.ContentType, base64);
    }

    private async Task PrintPdfDocument()
    {
        if (_pdfResult is null)
            return;

        if (await JS.InvokeAsync<bool>("oscPrintFrame", _pdfFrameId))
            return;

        // Fallback: open the document in its own tab so the user can print from there.
        var base64 = Convert.ToBase64String(_pdfResult.Content);
        await JS.InvokeVoidAsync("oscOpenInBrowser", _pdfResult.ContentType, base64);
    }

    public async ValueTask DisposeAsync()
    {
        await ReleaseObjectUrlAsync();
    }

    private async Task ReleaseObjectUrlAsync()
    {
        if (_pdfObjectUrl is null)
            return;

        var url = _pdfObjectUrl;
        _pdfObjectUrl = null;

        try
        {
            await JS.InvokeVoidAsync("oscRevokeBlobUrl", url);
        }
        catch (JSDisconnectedException)
        {
            // Circuit already closed: the browser released the blob anyway.
        }
    }
}
