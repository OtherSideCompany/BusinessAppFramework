@using MudBlazor

<div style="display:flex; flex-direction:column; min-width:0;">
    @if (!string.IsNullOrEmpty(Label) || LabelContent != null)
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="display:block; white-space:nowrap; font-variant-numeric:tabular-nums;">
            @Label
            @LabelContent
        </MudText>
    }
    <MudText Typo="@(Large ? Typo.h5 : Typo.h6)" Color="@(Primary ? Color.Primary : Color.Default)" Style="font-weight:700; line-height:1.3; font-variant-numeric:tabular-nums; white-space:nowrap;">@Value</MudText>
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool Primary { get; set; }
    [Parameter] public bool Large { get; set; }
    [Parameter] public RenderFragment? LabelContent { get; set; }
}
