@using System.Reflection
@using BusinessAppFramework.Application.Interfaces
@using Application.Relations
@using Domain.Attributes
@using MudBlazor
@using WebUI.Interfaces

@inject ILocalizedStringService LocalizedStringService
@inject IDialogService DialogService
@inject IWorkspaceDescriptorFactory WorkspaceDescriptorFactory
@inject IReferenceResolver RelationResolver
@inject IRelationSelectorRegistry RelationSelectorRegistry

<style>
    .category-header {
        cursor: pointer;
        user-select: none;
        border-radius: 6px;
        padding: 8px 4px;
        transition: background-color 120ms ease;
        background-color: var(--mud-palette-background-gray);
    }

        .category-header:hover {
            background-color: var(--mud-palette-action-default-hover);
        }

    .property-grid {
        display: grid;
        grid-template-columns: minmax(120px, 150px) minmax(0, 1fr);
        align-items: center;
    }

    .property-grid-label {
        display: flex;
        align-items: center;
        min-width: 0;
    }
</style>

@if (Target != null)
{
    var props = GetEditableProperties().ToList();

    <MudStack Spacing="0">
        @foreach (var category in GetCategoriesOrDefault())
        {
            <MudStack Spacing="2">

                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1"
                          Class="category-header"
                          @onclick="() => ToggleCategory(category)">
                    <MudIcon Icon="@category.Icon" Size="Size.Small" Style="width:16px; height:16px;" />
                    <MudText Typo="Typo.body2">@LocalizedStringService.Get(category.LabelKey)</MudText>
                    <MudSpacer />
                    <MudIcon Icon="@(category.IsExpanded ? Icons.Material.Rounded.ExpandMore : Icons.Material.Rounded.ChevronRight)"
                             Size="Size.Small" />
                </MudStack>

                <MudCollapse Expanded="(category.IsExpanded)" Style="width:100%;">
                    <div class="property-grid mx-1">
                        @foreach (var propEdition in category.PropertyEditions)
                        {
                            var label = LocalizedStringService.ResolveProperty(Target.GetType(), propEdition.PropertyName);
                            var propertyHelper = LocalizedStringService.ResolvePropertyHelper(Target.GetType(), propEdition.PropertyName);
                            var prop = props.FirstOrDefault(p => p.Name == propEdition.PropertyName);
                            if (prop != null)
                            {
                                <div class="property-grid-label">
                                    @if (string.IsNullOrEmpty(propertyHelper))
                                    {
                                        <MudText Style="color:var(--mud-palette-text-secondary);" Typo="Typo.caption">@label</MudText>
                                    }
                                    else
                                    {
                                        <MudTooltip>
                                            <TooltipContent>
                                                <MudText Typo="Typo.caption" Style="max-width:240px; white-space:normal; text-align:left;">
                                                    @propertyHelper
                                                </MudText>
                                            </TooltipContent>
                                            <ChildContent>
                                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                                    <MudText Style="color:var(--mud-palette-text-secondary);" Typo="Typo.caption">@label</MudText>
                                                    <MudIcon Icon="@Icons.Material.Outlined.Info" Style="color:var(--mud-palette-text-secondary); width:16px; height:16px;" />
                                                </MudStack>
                                            </ChildContent>
                                        </MudTooltip>
                                    }
                                </div>
                                <ObjectProperty PropertyEdition="propEdition"
                                                PropertyInfo="@prop"
                                                Target="@Target"
                                                OnChanged="async(PropertyInfo p) => await OnChanged.InvokeAsync(p)" />
                            }
                        }
                    </div>
                </MudCollapse>

            </MudStack>
        }

    </MudStack>
}

@code {
    [Parameter] public object? Target { get; set; }
    [Parameter] public EventCallback<PropertyInfo> OnChanged { get; set; }
    [Parameter] public List<PropertyCategory> PropertyCategories { get; set; } = new();

    private PropertyCategory _uncategorizedPropertyCategory = new PropertyCategory()
    {
        LabelKey = BusinessAppFramework.Contracts.StringKeys.OthersKey,
        Icon = Icons.Material.Outlined.MoreHoriz
    };

    private PropertyCategory? _defaultPropertyCategory;
    private List<PropertyCategory>? _categories;

    public void Refresh() => StateHasChanged();

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        _uncategorizedPropertyCategory.PropertyEditions = _uncategorizedProperties.Select(p => new PropertyEdition() { PropertyName = p.Name }).ToList();
    }

    private List<PropertyInfo> _uncategorizedProperties => GetEditableProperties()
        .Where(p => !PropertyCategories.Any(c => c.PropertyEditions.Any(e => e.PropertyName == p.Name)))
        .ToList();

    private List<PropertyCategory> GetDefaultCategory()
    {
        if (_defaultPropertyCategory == null)
        {
            _defaultPropertyCategory = new PropertyCategory()
            {
                IsExpanded = true,
                LabelKey = BusinessAppFramework.Contracts.StringKeys.GeneralKey,
                Icon = Icons.Material.Outlined.Info
            };

            _defaultPropertyCategory.PropertyEditions = GetEditableProperties().Select(p => new PropertyEdition() { PropertyName = p.Name }).ToList();
        }

        return new List<PropertyCategory> { _defaultPropertyCategory };
    }

    private List<PropertyCategory> GetCategoriesOrDefault()
    {
        if (!PropertyCategories.Any())
            return GetDefaultCategory();

        if (_categories == null)
        {
            _categories = new List<PropertyCategory>(PropertyCategories);

            if (_uncategorizedPropertyCategory.PropertyEditions.Any())
                _categories.Add(_uncategorizedPropertyCategory);
        }

        return _categories;
    }

    private IEnumerable<PropertyInfo> GetEditableProperties()
    {
        if (Target == null)
            return new List<PropertyInfo>();

        return Target.GetType()
            .GetProperties(BindingFlags.Public | BindingFlags.Instance)
            .Where(p => p.CanRead && p.CanWrite)
            .Where(p => !IsSystemProperty(p))
            .OrderBy(p => GetInheritanceDepth(p.DeclaringType))
            .ThenBy(p => p.MetadataToken);
    }

    private bool IsSystemProperty(PropertyInfo prop)
    {
        var declaringProp = prop.DeclaringType?.GetProperty(prop.Name, BindingFlags.Public | BindingFlags.Instance);
        return declaringProp?.IsDefined(typeof(SystemPropertyAttribute), false) == true;
    }

    private int GetInheritanceDepth(Type? type)
    {
        if (type == null) return int.MaxValue;
        int depth = 0;
        var current = type;
        while (current.BaseType != null) { depth++; current = current.BaseType; }
        return depth;
    }

    private void ToggleCategory(PropertyCategory category)
    {
        category.IsExpanded = !category.IsExpanded;
    }
}