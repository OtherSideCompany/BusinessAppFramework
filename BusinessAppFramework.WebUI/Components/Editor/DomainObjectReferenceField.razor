@using Application.Descriptors
@using BusinessAppFramework.Application.Interfaces
@using BusinessAppFramework.Application.Search
@using BusinessAppFramework.WebUI.Components.SearchList
@using Domain.DomainObjects
@using Microsoft.Extensions.DependencyInjection
@using MudBlazor
@using WebUI.Components.Selector
@using WebUI.Interfaces

@inject ILocalizedStringService LocalizedStringService
@inject IWorkspaceDescriptorFactory WorkspaceDescriptorFactory
@inject IRelationSelectorRegistry RelationSelectorRegistry
@inject IServiceProvider ServiceProvider
@inject IDialogService DialogService
@inject IReferenceNavigationKeyRegistry ReferenceNavigationKeyRegistry
@inject IRelationServiceGateway RelationServiceGateway
@inject IDomainObjectCreationDialogService DomainObjectCreationDialogService

<style>
    .mud-icon-button-size-small .mud-icon-root {
        font-size: 16px;
        width: 16px;
        height: 16px;
    }

    .lookup-field,
    .lookup-field .mud-input-slot,
    .lookup-field .mud-input-adornment {
        cursor: pointer;
    }

    .reference-chip { margin: 0; }

    .reference-chip > .mud-chip-content {
        min-width: 0;
        overflow: hidden;
    }

    .reference-chip > .mud-chip-content > .mud-typography {
        display: block;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .reference-chip .mud-chip-close-button {
        flex-shrink: 0;
    }

    .ghost-reference-button {
        border-style: dashed;
        border-color: var(--mud-palette-lines-inputs);
        border-radius: 16px;
        color: var(--mud-palette-lines-inputs);
        text-transform: none;
        white-space: nowrap;
    }
</style>

@if (IsCompact)
{
    @if (HasSelection)
    {
        <MudTooltip Text="@DomainObjectReference!.DisplayValue">
            @ReferenceChip(CompactText)
        </MudTooltip>
    }
    else if (_isSearching)
    {
        @SearchField
    }
    else
    {
        <MudButton Variant="Variant.Outlined"
                   Size="Size.Small"
                   Class="ghost-reference-button"
                   StartIcon="@Icons.Material.Outlined.Link"
                   OnClick="StartSearching">
            @EmptyLabel
        </MudButton>
    }
}
else if (HasSelection)
{
    <MudField Typo="Typo.body2"
              Variant="@Variant"
              Underline="false"
              Margin="Margin.Dense"
              Class="lookup-field"
              InnerPadding="false">

        <div style="margin-bottom:4px;">
            @if (!string.IsNullOrEmpty(DomainObjectReference!.DisplayValue))
            {
                @ReferenceChip(DomainObjectReference.DisplayValue)
            }
            else
            {
                <MudText Style="color: var(--mud-palette-text-disabled);">
                    @LocalizedStringService.Get(BusinessAppFramework.Contracts.StringKeys.SelectToSearchKey)
                </MudText>
            }
        </div>

    </MudField>
}
else
{
    @SearchField
}

@code {
    [Parameter]
    public DomainObjectReference? DomainObjectReference
    {
        get => _domainObjectReference;
        set
        {
            if (_domainObjectReference?.DomainObjectId == value?.DomainObjectId && _domainObjectReference?.RelationKey == value?.RelationKey)
                return;

            _domainObjectReference = value;
            ResolveSelectorDescriptor();
        }
    }
    [Parameter] public Variant Variant { get; set; } = Variant.Text;
    [Parameter] public EventCallback<DomainObjectReference?> OnDomainObjectReferenceChanged { get; set; }
    [Parameter] public PropertyEdition? PropertyEdition { get; set; }
    [Parameter] public DomainObjectReferenceDisplayMode DisplayMode { get; set; } = DomainObjectReferenceDisplayMode.DisplayValue;
    [Parameter] public string? EmptyLabel { get; set; }

    private DomainObjectReference? _domainObjectReference;
    private IDomainObjectSelectorDescriptor? _domainObjectSelectorDescriptor;
    private bool _isSearching;

    private bool HasSelection => DomainObjectReference?.DomainObjectId is not null;
    private bool CanCreate => !string.IsNullOrEmpty(_domainObjectSelectorDescriptor?.CreationDialogComponentKey);
    private bool IsCompact => DisplayMode == DomainObjectReferenceDisplayMode.ReferenceNumber;
    private string CompactText => string.IsNullOrEmpty(DomainObjectReference?.ReferenceNumber) ? DomainObjectReference?.DisplayValue ?? string.Empty : DomainObjectReference.ReferenceNumber;
    private string? NavigationKey => ReferenceNavigationKeyRegistry.TryGetNavigationKey(DomainObjectReference?.RelationKey ?? string.Empty);

    private int _pageSize = 10;

    private RenderFragment<string> ReferenceChip => text =>
        @<MudChip T="string"
                  Class="reference-chip"
                  Size="Size.Small"
                  Variant="Variant.Text"
                  Color="Color.Default"
                  CloseIcon="@Icons.Material.Rounded.Close"
                  OnClose="ClearSelectionAsync">
            @if (!string.IsNullOrEmpty(NavigationKey))
            {
                <NavigationLink NavigationApplicationActionKey="@NavigationKey"
                                DomainObjectId="@DomainObjectReference!.DomainObjectId!.Value"
                                Text="@text"
                                Underline="Underline.Hover" />
            }
            else
            {
                <MudText Typo="Typo.body2">@text</MudText>
            }
        </MudChip>;

    private RenderFragment SearchField =>
        @<MudAutocomplete T="DomainObjectSearchResult"
                          Variant="@Variant"
                          Margin="Margin.Dense"
                          Underline="false"
                          AutoFocus="@_isSearching"
                          ValueChanged="OnResultSelected"
                          SearchFunc="SearchAsync"
                          ToStringFunc="@(r => r?.DisplayValue ?? string.Empty)"
                          ResetValueOnEmptyText="false"
                          AdornmentIcon="@Icons.Material.Outlined.Search"
                          Adornment="Adornment.Start"
                          IconSize="Size.Small"
                          OnAdornmentClick="OpenSelector"
                          OnBlur="OnSearchBlurredAsync"
                          OnKeyDown="OnSearchKeyDown"
                          Placeholder="@LocalizedStringService.Get(BusinessAppFramework.Contracts.StringKeys.TypeToSearchKey)">
            <AfterItemsTemplate>
                <MudStack>
                    <MudButton FullWidth="true"
                               StartIcon="@Icons.Material.Outlined.Search"
                               IconColor="Color.Primary"
                               OnClick="OpenSelector">
                        @LocalizedStringService.Get(BusinessAppFramework.Contracts.StringKeys.SearchKey)
                    </MudButton>
                    @if (CanCreate)
                    {
                        <MudButton FullWidth="true"
                                   StartIcon="@Icons.Material.Outlined.Add"
                                   IconColor="Color.Primary"
                                   OnClick="CreateNewAsync">
                            @LocalizedStringService.Get(BusinessAppFramework.Contracts.StringKeys.NewKey)
                        </MudButton>
                    }
                </MudStack>
            </AfterItemsTemplate>
        </MudAutocomplete>;

    private void StartSearching()
    {
        _isSearching = true;
    }

    private async Task OnSearchBlurredAsync()
    {
        if (!_isSearching)
            return;

        await Task.Delay(300);

        if (!HasSelection)
        {
            _isSearching = false;
            StateHasChanged();
        }
    }

    private void OnSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
            _isSearching = false;
    }

    private async Task OpenSelector()
    {
        if (_domainObjectSelectorDescriptor == null || DomainObjectReference == null)
            return;

        var parameters = new DialogParameters
        {
            { nameof(SelectorDialog.Descriptor), _domainObjectSelectorDescriptor }
        };

        var options = new DialogOptions
        {
            BackdropClick = true,
            NoHeader = true,
            MaxWidth = MaxWidth.Large,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<SelectorDialog>(string.Empty, parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await SelectAsync((int)result.Data);
        }
    }

    private async Task CreateNewAsync()
    {
        if (_domainObjectSelectorDescriptor == null || DomainObjectReference == null)
            return;

        var createdId = await DomainObjectCreationDialogService.CreateAsync(_domainObjectSelectorDescriptor);

        if (createdId != null)
        {
            await SelectAsync(createdId.Value);
        }
    }

    private Task OnResultSelected(DomainObjectSearchResult? result)
        => result is null
            ? ClearSelectionAsync()
            : SelectAsync(result.DomainObjectId);

    private async Task SelectAsync(int domainObjectId)
    {
        if (DomainObjectReference == null)
            return;

        var hydrated = await RelationServiceGateway.GetHydratedDomainObjectReference(domainObjectId, DomainObjectReference.RelationKey);

        DomainObjectReference.DomainObjectId = domainObjectId;
        DomainObjectReference.DisplayValue = hydrated?.DisplayValue;
        DomainObjectReference.ReferenceNumber = hydrated?.ReferenceNumber ?? string.Empty;
        _isSearching = false;

        await OnDomainObjectReferenceChanged.InvokeAsync(DomainObjectReference);
        StateHasChanged();
    }

    private async Task ClearSelectionAsync()
    {
        if (DomainObjectReference is not null)
        {
            DomainObjectReference.DomainObjectId = null;
            DomainObjectReference.DisplayValue = null;
            DomainObjectReference.ReferenceNumber = string.Empty;
        }

        await OnDomainObjectReferenceChanged.InvokeAsync(DomainObjectReference);
        StateHasChanged();
    }

    private void ResolveSelectorDescriptor()
    {
        if (DomainObjectReference == null)
            return;

        var selectorWorkspaceKey = RelationSelectorRegistry.Resolve(DomainObjectReference.RelationKey);
        _domainObjectSelectorDescriptor = (IDomainObjectSelectorDescriptor)WorkspaceDescriptorFactory.GetWorkspaceDescriptor(selectorWorkspaceKey);
    }

    private async Task<IEnumerable<DomainObjectSearchResult>> SearchAsync(string searchText, CancellationToken token)
    {
        if (_domainObjectSelectorDescriptor is null)
            return [];

        var gatewayType = typeof(ISearchGateway<>).MakeGenericType(_domainObjectSelectorDescriptor.SearchResultType);
        var searchGateway = (ISearchGatewayBase)ServiceProvider.GetRequiredService(gatewayType);

        if (PropertyEdition != null && PropertyEdition.AvailableValuesParentId != null && !String.IsNullOrEmpty(PropertyEdition.AvailableValuesRelationKey))
        {
            var searchRequest = new SearchRequest()
            {
                SourceId = PropertyEdition.AvailableValuesParentId.Value,
                SourceRelationKey = PropertyEdition.AvailableValuesRelationKey,
                ConstraintKey = _domainObjectSelectorDescriptor.DefaultConstraintKey
            };

            var result = await searchGateway.SearchDomainObjectsAsync(searchRequest);

            return result.Items.OrderBy(i => i.DisplayValue);
        }
        else
        {
            var paginatedSearchRequest = new PaginatedSearchRequest
            {
                PageIndex = 0,
                PageSize = _pageSize * 2,
                ConstraintKey = _domainObjectSelectorDescriptor.DefaultConstraintKey
            };

            if (!String.IsNullOrEmpty(searchText))
            {
                paginatedSearchRequest.Filters.Add(searchText);
            }

            var result = await searchGateway.PaginatedSearchDomainObjectsAsync(paginatedSearchRequest);
            return result.Items.OrderBy(i => i.DisplayValue);
        }
    }
}
