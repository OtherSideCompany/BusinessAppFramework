@using BusinessAppFramework.Application.Interfaces
@using Contracts
@using MudBlazor
@using WebUI.Interfaces

@inject IIconFactory IconFactory
@inject ILocalizedStringService LocalizedStringService

<style>
    .osc-btn {
        font-weight: normal;
        border-radius: 16px;
        text-transform: none;
        transition: background-color .15s, border-color .15s;
        height: 24px;
        min-height: 24px;
        padding: 0 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .osc-btn .mud-icon-root {
            font-size: 16px;
        }

        .osc-btn.mud-icon-button {
            border-radius: 16px !important;
            height: 24px;
            width: 24px;
            min-width: 24px;
            padding: 0;
        }

        .osc-btn:disabled,
        .osc-btn.mud-disabled {
            opacity: .45;
            cursor: not-allowed;
        }
</style>

@if (Shrink)
{
    <MudTooltip Text="@LocalizedStringService.Get(ActionKey)">
        <MudIconButton Variant="Variant.Filled"
                       DropShadow="false"
                       Size="Size.Small"
                       Icon="@IconFactory.CreateIcon(ActionKey)"
                       OnClick="OnClickInternal"
                       Disabled="@Disabled"
                       Class="osc-btn"
                       Color="_color">
        </MudIconButton>
    </MudTooltip>
}
else
{
    <MudButton Variant="Variant.Filled"
               DropShadow="false"
               Size="Size.Small"
               StartIcon="@IconFactory.CreateIcon(ActionKey)"
               OnClick="OnClickInternal"
               Disabled="@Disabled"
               Class="osc-btn"
               Color="_color">
        @LocalizedStringService.Get(ActionKey)
    </MudButton>
}

@code {
    [Parameter] public string ActionKey { get; set; } = "";
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Shrink { get; set; }

    private Color _color => ActionKey == ActionKeys.DeleteActionKey ? Color.Error :
                            ActionKey == ActionKeys.CreateActionKey ? Color.Primary :
                            Color.Default;

    private async Task OnClickInternal(MouseEventArgs e)
    {
        if (Disabled)
            return;

        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync(e);
    }
}
