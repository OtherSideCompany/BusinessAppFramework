@using Application.Descriptors
@using BusinessAppFramework.Application.Interfaces
@using Application.Search
@using BusinessAppFramework.WebUI.Components.Browser
@using Domain.DomainObjects
@using Microsoft.AspNetCore.Components.Web;
@using MudBlazor
@using WebUI.Components.SearchList
@using WebUI.Interfaces

@inject ILocalizedStringService LocalizedStringService
@inject ISearchGateway<TSearchResult> SearchService
@inject IIconFactory IconFactory
@inject IDomainObjectCreationDialogService DomainObjectCreationDialogService

@typeparam TDomainObject where TDomainObject : DomainObject, new()
@typeparam TSearchResult where TSearchResult : DomainObjectSearchResult, new()

@implements IDomainObjectSelector

<style>
    .osc-search.mud-input-control {
        flex: 0 0 300px;
        max-width: 300px;
        min-width: 200px;
    }

        .osc-search.mud-input-control .mud-input {
            width: 100%;
        }

    .osc-search .mud-input-outlined-border {
        border-radius: 8px !important;
    }

    .osc-search .mud-input-outlined {
        border-radius: 8px !important;
    }
</style>

<DomainObjectSelectorLayout>

    <Header>
        <MudStack Row="false">

            <MudText Typo="Typo.h4">@LocalizedStringService.Get(Descriptor.WorkspaceKey)</MudText>

            <MudStack Row="true" AlignItems="AlignItems.Center">

                <MudTextField T="string"
                              Class="osc-search"
                              Placeholder="@LocalizedStringService.Get(Contracts.StringKeys.SearchKey)"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Small"
                              Variant="Variant.Outlined"
                              Underline="false"
                              @bind-Value="_filter"
                              OnKeyUp="HandleKeyUp"
                              Margin="Margin.Dense"
                              Style="background: var(--mud-palette-surface);" />

                @if (Descriptor.ConstraintKeys.Count > 1)
                {
                    <ConstraintChipSet Items="@ConstraintChipItems"
                                       SelectedKey="@_selectedConstraintKey"
                                       SelectedKeyChanged="OnConstraintChangedAsync" />
                }

                <MudText Typo="Typo.caption" Style="margin-top:4px; color:gray;">
                    @_totalItems @LocalizedStringService.Get(Contracts.StringKeys.ResultsKey)
                </MudText>

            </MudStack>

        </MudStack>
    </Header>

    <Results>
        <DynamicComponent Type="Descriptor.SearchListTemplateProviderType"
                          @ref="_templateComponent" />

        <MudDataGrid T="TSearchResult"
                     Dense="true"
                     Hover="true"
                     Elevation="0"
                     @ref="_grid"
                     ServerData="LoadGridData"
                     RowClass="cursor-pointer"
                     RowsPerPage="@_pageSize"
                     SelectedItemChanged="OnSelectedItemChangedAsync"
                     ReadOnly="true"
                     ColumnResizeMode="ResizeMode.Column"
                     Class="osc-datagrid">

            <Columns>
                @_searchListTemplateProvider?.Template?.DataGridColumns
            </Columns>

        </MudDataGrid>

    </Results>

    <Footer>
        @if (CanCreate)
        {
            <MudButton StartIcon="@Icons.Material.Sharp.Add"
                       IconColor="Color.Primary"
                       Variant="Variant.Text"
                       Size="Size.Small"
                       OnClick="CreateNewAsync"
                       Class="mt-2">
                @LocalizedStringService.Get(Contracts.StringKeys.NewKey)
            </MudButton>
        }
    </Footer>

</DomainObjectSelectorLayout>


@code {
    [Parameter] public DomainObjectSelectorDescriptor<TDomainObject, TSearchResult> Descriptor { get; set; } = default!;
    [Parameter] public EventCallback<int> OnItemSelected { get; set; }

    private string _filter { get; set; } = String.Empty;
    private string? _lastFilter;
    private string? _firstRenderFilter;
    private MudDataGrid<TSearchResult>? _grid;
    private DynamicComponent? _templateComponent;
    private ISearchListTemplateProvider<TSearchResult>? _searchListTemplateProvider => _templateComponent?.Instance as ISearchListTemplateProvider<TSearchResult>;

    private int _totalItems;
    private int _pageSize = 20;

    private bool _isLoadRequested = false;

    private string _selectedConstraintKey { get; set; } = default!;

    private Dictionary<string, int> _constraintCounts = new();

    private IEnumerable<ConstraintChipItem> ConstraintChipItems =>
        Descriptor.ConstraintKeys.Select(constraintKey => new ConstraintChipItem(
            constraintKey,
            LocalizedStringService.Get(constraintKey),
            _constraintCounts.TryGetValue(constraintKey, out var count) ? count : null));

    protected override void OnInitialized()
    {
        base.OnInitialized();

        _selectedConstraintKey = Descriptor.DefaultConstraintKey ?? string.Empty;
    }

    public async Task Load(string filter)
    {
        if (_grid != null)
        {
            if (_lastFilter == filter)
                return;

            _filter = filter;

            await ReloadAsync();
        }
        else
        {
            _firstRenderFilter = filter;
        }
    }

    private async Task ReloadAsync()
    {
        _isLoadRequested = true;

        if (_grid != null)
        {
            await _grid.ReloadServerData();
        }

        _isLoadRequested = false;

        _lastFilter = _filter;
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if ((e.Key == "Enter" || e.Key == "NumpadEnter") && _grid != null)
        {
            await ReloadAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !String.IsNullOrEmpty(_firstRenderFilter))
        {
            await Load(_firstRenderFilter);
        }
    }

    private async Task<GridData<TSearchResult>> LoadGridData(GridState<TSearchResult> state, CancellationToken cancellationToken)
    {
        if (!_isLoadRequested)
            return new GridData<TSearchResult> { Items = new List<TSearchResult>() };

        var request = new PaginatedSearchRequest
        {
            PageIndex = 0,
            PageSize = _pageSize,
            ConstraintKey = _selectedConstraintKey
        };

        if (!String.IsNullOrEmpty(_filter))
        {
            request.Filters.Add(_filter);
        }

        var result = await SearchService.PaginatedSearchAsync(request);

        var items = result?.Items?.ToList() ?? new List<TSearchResult>();
        _totalItems = result?.Count ?? 0;

        await RefreshConstraintCountsAsync();

        StateHasChanged();

        return new GridData<TSearchResult>
        {
            Items = items,
            TotalItems = _totalItems
        };
    }

    private async Task RefreshConstraintCountsAsync()
    {
        _constraintCounts.Clear();

        foreach (var constraintKey in Descriptor.ConstraintKeys)
        {
            _constraintCounts[constraintKey] = await SearchService.CountAsync(new SearchRequest() { ConstraintKey = constraintKey });
        }
    }

    private async Task OnConstraintChangedAsync(string? selectedConstraintKey)
    {
        _selectedConstraintKey = string.IsNullOrWhiteSpace(selectedConstraintKey)
            ? Contracts.ConstraintKeys.AllConstraintKey
            : selectedConstraintKey;

        await ReloadAsync();
    }

    private async Task OnSelectedItemChangedAsync(TSearchResult? item)
    {
        if (item != null)
        {
            await OnItemSelected.InvokeAsync(item.DomainObjectId);
        }
    }

    private bool CanCreate => !string.IsNullOrEmpty(Descriptor.CreationDialogComponentKey);

    private async Task CreateNewAsync()
    {
        var createdId = await DomainObjectCreationDialogService.CreateAsync(Descriptor);

        if (createdId != null)
        {
            await OnItemSelected.InvokeAsync(createdId.Value);
        }
    }
}


